# ============================================================
# MAYA Environment Variables
# Copy this file to .env.local and fill in your own keys.
# ============================================================

# --- Voice Transcription ---
# Get keys from https://console.groq.com
GROQ_KEY_1=gsk_YOUR_KEY_HERE
GROQ_KEY_2=gsk_YOUR_KEY_HERE

# --- AI Model API ---
# Three keys recommended for rotation under heavy load
NVIDIA_API_KEY_1=nvapi-YOUR_KEY_HERE
NVIDIA_API_KEY_2=nvapi-YOUR_KEY_HERE
NVIDIA_API_KEY_3=nvapi-YOUR_KEY_HERE

# --- Deployment ---
# Deployment (Required for app generation)
DEPLOY_TOKEN=your_vercel_deploy_token_here

# Screenshot Tooling (Optional but recommended)
# MAYA uses agent-browser for UI testing and visual analysis.
# Install globally via: npm install -g agent-browser && agent-browser install

# --- Authentication ---
# Get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Database (optional) ---
NEXT_PUBLIC_CONVEX_URL=https://YOUR_PROJECT.convex.cloud

# --- Demo Mode ---
# Set to true for accelerated cron cycles (5-10 min intervals for demos)
MAYA_DEMO_MODE=false
